<% title @job.title %>

<% content_for :ogp do %>
  <%= render "ogp",
        title: @job.title,
        description: job_render(@job, plain: true),
        url: job_url(@job),
        image: @job.ogp_image_url || image_url("banner.png") %>
<% end %>

<%= render "section", title: @job.title, title_element: "h1" do %>
  <article class="prose max-w-none">
    <%= job_render @job %>
  </article>

  <%= job_application_tag @job %>
<% end %>
