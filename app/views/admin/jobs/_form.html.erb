<%# locals: (job:) %>

<%= admin_form [:admin, job] do |f| %>
  <%= f.select_input :company_id, Company.order(:name).map { [_1.name, _1.id] }, label: "Company" %>
  <%= f.text_input :title %>
  <%= f.text_area_input :description %>
  <%= f.text_input :application_url %>
  <%= f.datetime_input :publish_at %>
  <%= f.datetime_input :expires_at %>
  <%= f.file_input :ogp_image %>
  <%= f.file_input :photos, multiple: true %>
  <%= f.submit %>
<% end %>
