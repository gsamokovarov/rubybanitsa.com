<%# locals: (admin_sidebar_links:) %>

<div class="flex grow flex-col gap-y-5 overflow-y-auto border-r border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-6">
  <div class="flex h-16 shrink-0 items-center gap-x-3 mx-auto">
    <%= image_tag "logo.svg", class: "h-8 w-auto", alt: "Ruby Banitsa logo" %>
    <span class="text-sm font-semibold text-gray-900 dark:text-gray-100">Ruby Banitsa</span>
  </div>

  <nav class="flex flex-1 flex-col">
    <ul role="list" class="flex flex-1 flex-col gap-y-7">
      <li>
        <ul role="list" class="-mx-2 space-y-1">
          <% admin_sidebar_links.each do |nav| %>
            <% if nav[:header] %>
              <li class="mt-4 first:mt-0">
                <div class="px-2 py-2 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                  <%= nav[:header] %>
                </div>
              </li>
            <% else %>
              <li>
                <% is_active = current_page?(nav[:path]) %>
                <%= link_to nav[:name], nav[:path], title: nav[:name], class: [
                  "block rounded-md py-2 pl-10 pr-2 text-sm/6 font-semibold text-gray-700 dark:text-gray-300 truncate hover:bg-gray-100 dark:hover:bg-gray-700",
                  "bg-gray-200 dark:bg-gray-700": is_active
                ] %>
              </li>
            <% end %>
          <% end %>
        </ul>
      </li>
      <li class="-mx-6 mt-auto">
        <%= link_to root_path, class: "flex items-center gap-x-4 px-6 py-3 text-sm/6 font-semibold text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-700", "data-turbo": false do %>
          <svg class="size-5 shrink-0 text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" d="M7.5 3.75A1.5 1.5 0 0 0 6 5.25v13.5a1.5 1.5 0 0 0 1.5 1.5h6a1.5 1.5 0 0 0 1.5-1.5V15a.75.75 0 0 1 1.5 0v3.75a3 3 0 0 1-3 3h-6a3 3 0 0 1-3-3V5.25a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3V9A.75.75 0 0 1 15 9V5.25a1.5 1.5 0 0 0-1.5-1.5h-6Zm5.03 4.72a.75.75 0 0 1 0 1.06l-1.72 1.72h10.94a.75.75 0 0 1 0 1.5H10.81l1.72 1.72a.75.75 0 1 1-1.06 1.06l-3-3a.75.75 0 0 1 0-1.06l3-3a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
          </svg>

          <span aria-hidden="true">View site</span>
        <% end %>
      </li>
    </ul>
  </nav>
</div>
