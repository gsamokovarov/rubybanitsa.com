<%# locals: (contacts:) %>

<%= admin_table contacts do
  column "#", -> { link_to _1.id, admin_contact_path(_1) }
  column :company, -> { link_to _1.company.name, admin_company_path(_1.company) }
  column :name, -> { link_to _1.name, admin_contact_path(_1) }
  column :email, -> { mail_to _1.email }
  column -> { admin_button(:danger, :small, delete: [:admin, _1]) { "Delete" } }
end %>
