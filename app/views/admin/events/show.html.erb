<% content_for :head do %>
  <style>
    /* BT Mono Bold — the face the logo wordmark is set in (app/assets/fonts) */
    @font-face {
      font-family: "BT Mono";
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url(<%= asset_path "bt_mono-Bold.woff2" %>) format("woff2"),
           url(<%= asset_path "bt_mono-Bold.woff" %>) format("woff");
    }
  </style>

  <% if @event.vibe? %>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&display=swap" rel="stylesheet">
  <% end %>
<% end %>

<%= render "section", title: "Event ##{@event.id}", cta: -> {
  admin_button(:secondary, post: admin_event_publish_path(@event)) { "Publish" } unless @event.published?
} do %>
  <%= render "form", event: @event %>
<% end %>

<%= render "section", title: "Banner", description: "The social share banner, rendered at its real size." do %>
  <div class="overflow-x-auto">
    <div class="inline-block <%= "vibe" if @event.vibe? %>">
      <div class="brand-surface">
        <%= render "banner", event: @event %>
      </div>
    </div>
  </div>
<% end %>

<%= render "section", title: "Picture in picture", description: "Stream overlay layouts for the recording, rendered at their real size." do %>
  <div class="overflow-x-auto">
    <div class="inline-block py-6 <%= "vibe" if @event.vibe? %>">
      <%= render "pip", event: @event %>
    </div>
  </div>
<% end %>

<%= render "section", title: "Talks", cta: -> {
  admin_button(:primary, link: new_admin_talk_path(event_id: @event.id)) { "New talk" }
} do %>
  <% talks = @event.talks.includes(:event, :speakers) %>
  <% if talks.any? %>
    <%= render "admin/talks/talks", talks: %>
  <% else %>
    <%= render "empty_state" do %>
      <%= admin_button(:primary, link: new_admin_talk_path(event_id: @event.id)) { "New talk" } %>
    <% end %>
  <% end %>
<% end %>

<%= render "section", title: "Sponsorships", cta: -> {
  admin_button(:primary, link: new_admin_sponsorship_path(event_id: @event.id)) { "New sponsorship" }
} do %>
  <% sponsorships = @event.sponsorships.includes(:event, :company) %>
  <% if sponsorships.any? %>
    <%= render "admin/sponsorships/sponsorships", sponsorships: %>
  <% else %>
    <%= render "empty_state" do %>
      <%= admin_button(:primary, link: new_admin_sponsorship_path(event_id: @event.id)) { "New sponsorship" } %>
    <% end %>
  <% end %>
<% end %>
