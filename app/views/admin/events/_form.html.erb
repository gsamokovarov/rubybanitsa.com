<%# locals: (event:) %>

<%= admin_form [:admin, event] do |f| %>
  <%= f.text_input :name %>
  <%= f.check_box_input :vibe %>
  <%= f.datetime_input :time %>
  <%= f.select_input :venue_id, Venue.order(:name).map { [_1.name, _1.id] }, label: "Venue" %>
  <%= f.text_area_input :description %>
  <%= f.file_input :ogp_image %>
  <%= f.text_input :online_url %>
  <%= f.text_input :facebook_url %>
  <%= f.submit %>
<% end %>
